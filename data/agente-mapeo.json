    { "id": "intellij",      "programa": "^IntelliJ IDEA",                                      "vendor": "JetBrains", "product": "intellij_idea" },
    { "id": "openssl",       "programa": "^OpenSSL",                                            "vendor": "Unknown", "product": "openssl" },

    { "id": "mysql",         "programa": "^MySQL Server",            "servicio": "^MySQL\\d*$",        "vendor": "Oracle / IBM", "product": "mysql_server" },
    { "id": "mariadb",       "programa": "^MariaDB",                 "servicio": "^MariaDB",           "vendor": "MariaDB Foundation", "product": "mariadb" },
    { "id": "postgresql",    "programa": "^PostgreSQL",              "servicio": "^postgresql",        "vendor": "PostgreSQL Global Development Group", "product": "postgresql" },
    { "id": "mongodb",       "programa": "^MongoDB",                 "servicio": "^MongoDB",           "vendor": "MongoDB Inc.", "product": "mongodb" },
    { "id": "redis",         "programa": "^Redis",                   "servicio": "^Redis",             "vendor": "Redis Ltd.", "product": "redis" },

    { "id": "apache_httpd",  "programa": "^Apache HTTP Server|^XAMPP", "servicio": "^Apache2?\\.?\\d*$", "vendor": "Apache Foundation", "product": "http_server", "atributos": { "accessible_from_browser": true } },
    { "id": "tomcat",        "programa": "^Apache Tomcat",           "servicio": "^Tomcat\\d*$",       "vendor": "Apache Foundation", "product": "tomcat", "atributos": { "accessible_from_browser": true } },
    { "id": "jenkins",       "programa": "^Jenkins",                 "servicio": "^Jenkins$",          "vendor": "Jenkins / CloudBees", "product": "jenkins", "atributos": { "accessible_from_browser": true } },

    { "id": "virtualbox",    "programa": "^Oracle (VM )?VirtualBox",                            "vendor": "VMware", "product": "vm_virtualbox" },
    { "id": "vlc",           "programa": "^VLC media player",                                   "vendor": "VideoLAN", "product": "vlc_media_player" },
    { "id": "gimp",          "programa": "^GIMP",                                               "vendor": "GIMP", "product": "gimp" },
    { "id": "wireshark",     "programa": "^Wireshark",                                          "vendor": "Wireshark Foundation", "product": "wireshark" },
    { "id": "imagemagick",   "programa": "^ImageMagick",                                        "vendor": "ImageMagick", "product": "imagemagick" },

    { "id": "zoom",          "programa": "^Zoom( Workplace| Meetings|$)",                       "vendor": "Unknown", "product": "zoom" },
    { "id": "forticlient",   "programa": "^FortiClient",                                        "vendor": "Unknown", "product": "forticlient" },
    { "id": "anyconnect",    "programa": "^Cisco (AnyConnect|Secure Client)",                   "vendor": "Cisco", "product": "anyconnect_secure_mobility_client" },
    { "id": "rdm",           "programa": "^Remote Desktop Manager",                             "vendor": "Unknown", "product": "remote_desktop_manager" },
    { "id": "clamav",        "programa": "^ClamAV|^ClamWin",                                    "vendor": "IBM", "product": "clamav" }
