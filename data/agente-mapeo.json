{
  "_comentario": [
    "Reglas para traducir el inventario del agente (.exe) al catálogo del modelo (data/tech-catalog.json).",
    "Cada regla se cumple si CUALQUIERA de sus patrones coincide (expresiones regulares, sin distinguir mayúsculas):",
    "  programa → nombre del software instalado   |  servicio → nombre o nombre visible del servicio",
    "  proceso  → nombre del proceso en ejecución",
    "vendor y product DEBEN existir en tech-catalog.json (la API ignora y avisa las que no existan).",
    "atributos (opcional) sobreescribe las respuestas por defecto del cuestionario para ese sistema:",
    "  accessible_from_browser (se usa desde un navegador web), requires_login, controls_devices.",
    "Para agregar una tecnología: copia una regla, ajusta el patrón y reinicia la API."
  ],
  "version": 1,
  "sistema_operativo": {
    "_comentario": "Windows se resuelve en código: intenta windows_11_23h2 → windows_11 → windows, según existan en el catálogo.",
    "vendor": "Microsoft"
  },
  "reglas": [
    { "id": "office",        "programa": "^Microsoft (Office|365)\\b",                         "vendor": "Microsoft", "product": "office" },
    { "id": "edge",          "programa": "^Microsoft Edge$",                                    "vendor": "Microsoft", "product": "edge_chromium" },
    { "id": "sql_server",    "programa": "^Microsoft SQL Server 20\\d\\d( \\(64-bit\\))?$",    "servicio": "^MSSQL(SERVER|\\$)", "vendor": "Microsoft", "product": "sql_server" },
    { "id": "exchange",      "servicio": "^MSExchange",                                         "vendor": "Microsoft", "product": "exchange_server", "atributos": { "accessible_from_browser": true } },
    { "id": "dotnet_fw",     "programa": "^Microsoft \\.NET Framework",                         "vendor": "Microsoft", "product": ".net_framework" },
    { "id": "dotnet",        "programa": "^Microsoft (\\.NET|ASP\\.NET Core|Windows Desktop) Runtime", "vendor": "Microsoft", "product": ".net" },
    { "id": "vscode",        "programa": "^Microsoft Visual Studio Code",                       "vendor": "Microsoft", "product": "visual_studio_code" },
    { "id": "visualstudio",  "programa": "^(Microsoft )?Visual Studio (Community|Professional|Enterprise)", "vendor": "Microsoft", "product": "visual_studio" },
    { "id": "iis",           "servicio": "^W3SVC$",                                             "vendor": "Unknown",   "product": "internet_information_services", "atributos": { "accessible_from_browser": true } },

    { "id": "chrome",        "programa": "^Google Chrome$",                                     "vendor": "Google",  "product": "chrome" },
    { "id": "firefox_esr",   "programa": "^Mozilla Firefox.*ESR",                              "vendor": "Mozilla", "product": "firefox_esr" },
    { "id": "firefox",       "programa": "^Mozilla Firefox(?!.*ESR)",                          "vendor": "Mozilla", "product": "firefox" },
    { "id": "thunderbird",   "programa": "^Mozilla Thunderbird",                                "vendor": "Unknown", "product": "thunderbird" },
    { "id": "opera",         "programa": "^Opera (Stable|\\d)",                                 "vendor": "Opera",   "product": "opera_browser" },

    { "id": "acrobat_reader","programa": "^Adobe Acrobat Reader",                               "vendor": "Adobe", "product": "acrobat_reader_dc" },
    { "id": "acrobat",       "programa": "^Adobe Acrobat (DC|Pro|Standard|\\(64-bit\\))",       "vendor": "Adobe", "product": "acrobat_dc" },
    { "id": "flash",         "programa": "^Adobe Flash Player",                                 "vendor": "Adobe", "product": "flash_player" },
    { "id": "libreoffice",   "programa": "^LibreOffice",                                        "vendor": "The Document Foundation", "product": "libreoffice" },
    { "id": "openoffice",    "programa": "^(Apache )?OpenOffice",                               "vendor": "Apache OpenOffice", "product": "openoffice" },

    { "id": "jre",           "programa": "^Java( \\d+)?( Update \\d+)?( \\(64-bit\\))?$|^Java\\(TM\\) SE Runtime", "vendor": "Oracle / OpenJDK", "product": "jre" },
    { "id": "jdk",           "programa": "^Java\\(TM\\) SE Development Kit|^Java SE Development Kit|^JDK ", "vendor": "Oracle / OpenJDK", "product": "jdk" },
    { "id": "openjdk",       "programa": "OpenJDK|Eclipse Temurin|Amazon Corretto",              "vendor": "Oracle / OpenJDK", "product": "openjdk" },
    { "id": "nodejs",        "programa": "^Node\\.js",                                          "vendor": "OpenJS Foundation", "product": "node.js" },
    { "id": "python",        "programa": "^Python 3\\.\\d+",                                    "vendor": "Unknown", "product": "python" },
    { "id": "php",           "programa": "^PHP \\d|^XAMPP|^WampServer",                          "vendor": "Unknown", "product": "php" },
    { "id": "git",           "programa": "^Git( version)?( \\d|$)",                             "vendor": "Git", "product": "git" },
